{
	"name": "@when/config",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"scripts": {
		"generate:schema": "node scripts/generate-json-schemas.js && prettier --write src/config.schema.json",
		"build:assets": "cp src/config.schema.json dist/src/",
		"build": "pnpm generate:schema && tsc -p tsconfig.json && tsc -p tsconfig.build.json && pnpm build:assets",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@sinclair/typebox": "0.34.49",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"json-schema-to-typescript": "15.0.4",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
