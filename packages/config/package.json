{
	"name": "@when/config",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js"
		}
	},
	"files": [
		"dist/*",
		"package.json"
	],
	"scripts": {
		"generate:types": "json2ts --input src/config.schema.json --output src/schema.ts --no-bannerComment",
		"generate:external-schema": "node scripts/generate-external-schema.js",
		"build:assets": "cp src/config.schema.json src/config.external.schema.json dist/src/",
		"build": "pnpm generate:types && pnpm generate:external-schema && tsc -p tsconfig.json && tsc -p tsconfig.build.json && pnpm build:assets",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"json-schema-to-typescript": "15.0.4",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
