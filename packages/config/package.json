{
	"name": "@when/config",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"scripts": {
		"generate:types": "json2ts --input src/config.schema.json --output src/schema.d.ts --no-bannerComment",
		"build": "pnpm generate:types && tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"json-schema-to-typescript": "^15.0.4",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
