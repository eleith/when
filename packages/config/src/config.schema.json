{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://when.app/schema/config.json",
	"additionalProperties": false,
	"title": "When configuration",
	"description": "Canonical schema for the When self-hosted scheduling app's config.yaml.",
	"type": "object",
	"required": ["auth", "user", "smtp", "calendars", "availability", "event_types"],
	"properties": {
		"auth": {
			"$ref": "#/$defs/Auth"
		},
		"user": {
			"$ref": "#/$defs/User"
		},
		"smtp": {
			"$ref": "#/$defs/Smtp"
		},
		"calendars": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/Calendar"
			}
		},
		"availability": {
			"$ref": "#/$defs/Availability"
		},
		"event_types": {
			"minItems": 1,
			"type": "array",
			"items": {
				"$ref": "#/$defs/EventType"
			}
		},
		"database": {
			"default": {},
			"$ref": "#/$defs/DatabaseConfig"
		},
		"url": {
			"default": {},
			"$ref": "#/$defs/Url"
		},
		"prometheus": {
			"default": {},
			"$ref": "#/$defs/PrometheusConfig"
		}
	},
	"$defs": {
		"Auth": {
			"title": "Auth",
			"description": "Admin auth strategy. Exactly one of `oidc` or `credentials` must be declared.",
			"anyOf": [
				{
					"additionalProperties": false,
					"type": "object",
					"required": ["oidc"],
					"properties": {
						"oidc": {
							"$ref": "#/$defs/OidcAuth"
						},
						"credentials": {
							"type": "null"
						}
					}
				},
				{
					"additionalProperties": false,
					"type": "object",
					"required": ["credentials"],
					"properties": {
						"credentials": {
							"$ref": "#/$defs/CredentialsAuth"
						},
						"oidc": {
							"type": "null"
						}
					}
				}
			]
		},
		"Availability": {
			"additionalProperties": false,
			"title": "Availability",
			"description": "Global availability defaults. Each knob is overridable per event type.",
			"type": "object",
			"required": ["default"],
			"properties": {
				"slot_granularity": {
					"minimum": 1,
					"default": 15,
					"type": "integer"
				},
				"minimum_notice": {
					"minimum": 0,
					"default": 120,
					"type": "integer"
				},
				"maximum_lookahead": {
					"minimum": 1,
					"default": 60,
					"type": "integer"
				},
				"buffer_before": {
					"minimum": 0,
					"default": 0,
					"type": "integer"
				},
				"buffer_after": {
					"minimum": 0,
					"default": 0,
					"type": "integer"
				},
				"max_appointments_per_day": {
					"default": null,
					"anyOf": [
						{
							"minimum": 1,
							"type": "integer"
						},
						{
							"type": "null"
						}
					]
				},
				"default": {
					"$ref": "#/$defs/WeeklySchedule"
				}
			}
		},
		"Branding": {
			"additionalProperties": false,
			"title": "Branding",
			"type": "object",
			"properties": {
				"logo_url": {
					"minLength": 1,
					"type": "string"
				},
				"color": {
					"additionalProperties": false,
					"default": {},
					"type": "object",
					"properties": {
						"primary": {
							"additionalProperties": false,
							"default": {},
							"type": "object",
							"properties": {
								"light": {
									"default": "#4f46e5",
									"$ref": "#/$defs/HexColor"
								},
								"dark": {
									"default": "#818cf8",
									"$ref": "#/$defs/HexColor"
								}
							}
						}
					}
				},
				"avatar_url": {
					"minLength": 1,
					"type": "string"
				},
				"favicon_url": {
					"minLength": 1,
					"type": "string"
				},
				"page_title": {
					"minLength": 1,
					"type": "string"
				},
				"description": {
					"minLength": 1,
					"type": "string"
				}
			}
		},
		"CalDavCalendar": {
			"additionalProperties": false,
			"title": "CalDavCalendar",
			"type": "object",
			"required": ["id", "type", "url", "username", "password"],
			"properties": {
				"id": {
					"minLength": 1,
					"type": "string"
				},
				"type": {
					"const": "caldav",
					"type": "string"
				},
				"url": {
					"format": "uri",
					"type": "string"
				},
				"username": {
					"minLength": 1,
					"type": "string"
				},
				"password": {
					"minLength": 1,
					"type": "string"
				},
				"sync": {
					"$ref": "#/$defs/CalendarSync"
				}
			}
		},
		"Calendar": {
			"title": "Calendar",
			"anyOf": [
				{
					"$ref": "#/$defs/GoogleCalendar"
				},
				{
					"$ref": "#/$defs/CalDavCalendar"
				}
			]
		},
		"CalendarSync": {
			"additionalProperties": false,
			"title": "CalendarSync",
			"description": "Per-calendar sync cadence.",
			"type": "object",
			"properties": {
				"refresh_interval": {
					"description": "Minutes between the worker's busy-time refreshes for this calendar.",
					"minimum": 1,
					"default": 10,
					"type": "integer"
				}
			}
		},
		"CredentialsAuth": {
			"additionalProperties": false,
			"title": "CredentialsAuth",
			"description": "Local username/password.",
			"type": "object",
			"required": ["username"],
			"properties": {
				"username": {
					"minLength": 1,
					"type": "string"
				},
				"password": {
					"minLength": 1,
					"default": "${WHEN_ADMIN_PASSWORD}",
					"type": "string"
				}
			}
		},
		"DatabaseConfig": {
			"additionalProperties": false,
			"title": "DatabaseConfig",
			"description": "On-disk SQLite paths. Relative paths resolve against this config file's directory, so web and worker (which load the same config.yaml) open the same files.",
			"type": "object",
			"properties": {
				"app": {
					"description": "Application database (appointments, oauth tokens).",
					"minLength": 1,
					"default": "./data/when.sqlite",
					"type": "string"
				},
				"queue": {
					"description": "openworkflow job queue database.",
					"minLength": 1,
					"default": "./data/openworkflow.sqlite",
					"type": "string"
				}
			}
		},
		"DaySchedule": {
			"title": "DaySchedule",
			"description": "Array of HH:MM-HH:MM time ranges in the user's timezone.",
			"type": "array",
			"items": {
				"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$",
				"type": "string"
			}
		},
		"EventType": {
			"additionalProperties": false,
			"title": "EventType",
			"type": "object",
			"required": ["id", "name", "duration", "slug", "appointment_flow", "destination_calendar"],
			"properties": {
				"id": {
					"minLength": 1,
					"type": "string"
				},
				"name": {
					"minLength": 1,
					"type": "string"
				},
				"duration": {
					"minimum": 1,
					"type": "integer"
				},
				"description": {
					"type": "string"
				},
				"slug": {
					"pattern": "^[a-z0-9][a-z0-9-]*$",
					"type": "string"
				},
				"visibility": {
					"default": "public",
					"anyOf": [
						{
							"const": "public",
							"type": "string"
						},
						{
							"const": "private",
							"type": "string"
						}
					]
				},
				"appointment_flow": {
					"anyOf": [
						{
							"const": "auto",
							"type": "string"
						},
						{
							"const": "requires_confirmation",
							"type": "string"
						}
					]
				},
				"conflict_calendars": {
					"default": [],
					"type": "array",
					"items": {
						"minLength": 1,
						"type": "string"
					}
				},
				"destination_calendar": {
					"minLength": 1,
					"type": "string"
				},
				"location": {
					"$ref": "#/$defs/Location"
				},
				"note": {
					"minLength": 1,
					"type": "string"
				},
				"conference": {
					"format": "uri",
					"type": "string"
				},
				"slot_granularity": {
					"minimum": 1,
					"type": "integer"
				},
				"minimum_notice": {
					"minimum": 0,
					"type": "integer"
				},
				"maximum_lookahead": {
					"minimum": 1,
					"type": "integer"
				},
				"buffer_before": {
					"minimum": 0,
					"type": "integer"
				},
				"buffer_after": {
					"minimum": 0,
					"type": "integer"
				},
				"max_appointments_per_day": {
					"anyOf": [
						{
							"minimum": 1,
							"type": "integer"
						},
						{
							"type": "null"
						}
					]
				},
				"image_url": {
					"minLength": 1,
					"type": "string"
				},
				"form_fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/FormField"
					}
				}
			}
		},
		"FormField": {
			"additionalProperties": false,
			"title": "FormField",
			"type": "object",
			"required": ["id", "type", "label"],
			"properties": {
				"id": {
					"minLength": 1,
					"type": "string"
				},
				"type": {
					"anyOf": [
						{
							"const": "guest_name",
							"type": "string"
						},
						{
							"const": "guest_email",
							"type": "string"
						},
						{
							"const": "event_location",
							"type": "string"
						},
						{
							"const": "text",
							"type": "string"
						},
						{
							"const": "number",
							"type": "string"
						},
						{
							"const": "paragraph",
							"type": "string"
						},
						{
							"const": "choice",
							"type": "string"
						}
					]
				},
				"label": {
					"minLength": 1,
					"type": "string"
				},
				"required": {
					"default": false,
					"type": "boolean"
				},
				"choices": {
					"type": "array",
					"items": {
						"minLength": 1,
						"type": "string"
					}
				}
			}
		},
		"GoogleCalendar": {
			"additionalProperties": false,
			"title": "GoogleCalendar",
			"type": "object",
			"required": [
				"id",
				"type",
				"client_id",
				"client_secret",
				"refresh_token",
				"google_calendar_id"
			],
			"properties": {
				"id": {
					"minLength": 1,
					"type": "string"
				},
				"type": {
					"const": "google",
					"type": "string"
				},
				"client_id": {
					"minLength": 1,
					"type": "string"
				},
				"client_secret": {
					"minLength": 1,
					"type": "string"
				},
				"refresh_token": {
					"minLength": 1,
					"type": "string"
				},
				"google_calendar_id": {
					"minLength": 1,
					"type": "string"
				},
				"sync": {
					"$ref": "#/$defs/CalendarSync"
				}
			}
		},
		"HexColor": {
			"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
			"type": "string"
		},
		"LocationFixed": {
			"additionalProperties": false,
			"title": "LocationFixed",
			"type": "object",
			"required": ["mode", "fixed"],
			"properties": {
				"mode": {
					"const": "fixed",
					"type": "string"
				},
				"fixed": {
					"minLength": 1,
					"type": "string"
				}
			}
		},
		"Location": {
			"title": "Location",
			"$ref": "#/$defs/LocationFixed"
		},
		"OidcAuth": {
			"additionalProperties": false,
			"title": "OidcAuth",
			"type": "object",
			"required": ["issuer", "client_id", "client_secret"],
			"properties": {
				"issuer": {
					"format": "uri",
					"type": "string"
				},
				"client_id": {
					"minLength": 1,
					"type": "string"
				},
				"client_secret": {
					"minLength": 1,
					"type": "string"
				}
			}
		},
		"PrometheusConfig": {
			"additionalProperties": false,
			"title": "PrometheusConfig",
			"description": "Prometheus metrics collection settings.",
			"type": "object",
			"properties": {
				"enabled": {
					"description": "Whether metrics collection and endpoint are active.",
					"default": false,
					"type": "boolean"
				},
				"secret": {
					"description": "Bearer token for scraping metrics. Defaults to METRICS_TOKEN env var.",
					"default": "${METRICS_TOKEN:-}",
					"type": "string"
				}
			}
		},
		"Smtp": {
			"additionalProperties": false,
			"title": "Smtp",
			"description": "SMTP server used to send appointment emails. Required — the appointment system relies on it.",
			"type": "object",
			"required": ["host", "port", "user", "pass"],
			"properties": {
				"host": {
					"minLength": 1,
					"type": "string"
				},
				"port": {
					"minimum": 1,
					"maximum": 65535,
					"type": "integer"
				},
				"user": {
					"minLength": 1,
					"type": "string"
				},
				"pass": {
					"minLength": 1,
					"type": "string"
				},
				"from": {
					"description": "Email address used as the From on all emails and as the organizer on guest-facing calendar invites, so the host's own address is never exposed. Must be an address your SMTP server is allowed to send from. Defaults to noreply@<your url.app domain>. The display name always comes from user.name.",
					"minLength": 1,
					"type": "string"
				}
			}
		},
		"Url": {
			"additionalProperties": false,
			"title": "Url",
			"description": "Public URLs for the app.",
			"type": "object",
			"properties": {
				"app": {
					"description": "Public base URL of the app (include the scheme), used to build links in emails and calendar events.",
					"minLength": 1,
					"default": "http://localhost:5173",
					"type": "string"
				},
				"internal": {
					"description": "Base URL the worker uses to reach the app over the internal network (e.g. http://when-app:3000), used to fetch relative branding images for embedding in emails. Defaults to the WHEN_URL_INTERNAL env var (baked into the Docker images per target); empty falls back to `app`.",
					"default": "${WHEN_URL_INTERNAL:-}",
					"type": "string"
				},
				"worker": {
					"description": "Base URL the web app uses to reach the worker over the internal network (e.g. http://when-worker:9000), used to query private worker telemetry and metrics.",
					"default": "http://when-worker:9000",
					"type": "string"
				}
			}
		},
		"User": {
			"additionalProperties": false,
			"title": "User",
			"type": "object",
			"required": ["name", "timezone", "email"],
			"properties": {
				"name": {
					"minLength": 1,
					"type": "string"
				},
				"timezone": {
					"description": "IANA timezone identifier (e.g. America/New_York).",
					"minLength": 1,
					"type": "string"
				},
				"email": {
					"format": "email",
					"type": "string"
				},
				"branding": {
					"default": {},
					"$ref": "#/$defs/Branding"
				}
			}
		},
		"WeeklySchedule": {
			"additionalProperties": false,
			"title": "WeeklySchedule",
			"type": "object",
			"properties": {
				"monday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"tuesday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"wednesday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"thursday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"friday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"saturday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"sunday": {
					"$ref": "#/$defs/DaySchedule"
				}
			}
		}
	}
}
