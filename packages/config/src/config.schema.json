{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://when.app/schema/config.json",
	"title": "When configuration",
	"description": "Canonical schema for the When self-hosted scheduling app's config.yaml.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"auth",
		"user",
		"smtp",
		"calendars",
		"availability",
		"event_types",
		"database",
		"url",
		"prometheus"
	],
	"properties": {
		"auth": {
			"$ref": "#/$defs/Auth"
		},
		"user": {
			"$ref": "#/$defs/User"
		},
		"smtp": {
			"$ref": "#/$defs/Smtp"
		},
		"calendars": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/Calendar"
			}
		},
		"availability": {
			"$ref": "#/$defs/Availability"
		},
		"event_types": {
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/EventType"
			}
		},
		"database": {
			"$ref": "#/$defs/DatabaseConfig",
			"default": {}
		},
		"url": {
			"$ref": "#/$defs/Url",
			"default": {}
		},
		"prometheus": {
			"$ref": "#/$defs/PrometheusConfig",
			"default": {}
		}
	},
	"$defs": {
		"Url": {
			"title": "Url",
			"description": "Public URLs for the app.",
			"type": "object",
			"additionalProperties": false,
			"required": ["app", "internal", "worker"],
			"properties": {
				"app": {
					"type": "string",
					"description": "Public base URL of the app (include the scheme), used to build links in emails and calendar events.",
					"minLength": 1,
					"default": "http://localhost:5173"
				},
				"internal": {
					"type": "string",
					"description": "Base URL the worker uses to reach the app over the internal network (e.g. http://when-app:3000), used to fetch relative branding images for embedding in emails. Defaults to the WHEN_URL_INTERNAL env var (baked into the Docker images per target); empty falls back to `app`.",
					"default": "${WHEN_URL_INTERNAL:-}"
				},
				"worker": {
					"type": "string",
					"description": "Base URL the web app uses to reach the worker over the internal network (e.g. http://when-worker:9000), used to query private worker telemetry and metrics.",
					"default": "http://when-worker:9000"
				}
			}
		},
		"DatabaseConfig": {
			"title": "DatabaseConfig",
			"description": "On-disk SQLite paths. Relative paths resolve against this config file's directory, so web and worker (which load the same config.yaml) open the same files.",
			"type": "object",
			"additionalProperties": false,
			"required": ["app", "queue"],
			"properties": {
				"app": {
					"type": "string",
					"description": "Application database (appointments, oauth tokens).",
					"minLength": 1,
					"default": "./data/when.sqlite"
				},
				"queue": {
					"type": "string",
					"description": "openworkflow job queue database.",
					"minLength": 1,
					"default": "./data/openworkflow.sqlite"
				}
			}
		},
		"Auth": {
			"title": "Auth",
			"description": "Admin auth strategy. Exactly one of `oidc` or `credentials` must be declared.",
			"type": "object",
			"oneOf": [
				{
					"additionalProperties": false,
					"required": ["oidc"],
					"properties": {
						"oidc": {
							"$ref": "#/$defs/OidcAuth"
						}
					}
				},
				{
					"additionalProperties": false,
					"required": ["credentials"],
					"properties": {
						"credentials": {
							"$ref": "#/$defs/CredentialsAuth"
						}
					}
				}
			]
		},
		"OidcAuth": {
			"title": "OidcAuth",
			"type": "object",
			"additionalProperties": false,
			"required": ["issuer", "client_id", "client_secret"],
			"properties": {
				"issuer": {
					"type": "string",
					"format": "uri"
				},
				"client_id": {
					"type": "string",
					"minLength": 1
				},
				"client_secret": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"CredentialsAuth": {
			"title": "CredentialsAuth",
			"description": "Local username/password. `password_hash` is an argon2/bcrypt hash (generate with `pnpm hash-password`).",
			"type": "object",
			"additionalProperties": false,
			"required": ["username", "password_hash"],
			"properties": {
				"username": {
					"type": "string",
					"minLength": 1
				},
				"password_hash": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"User": {
			"title": "User",
			"type": "object",
			"additionalProperties": false,
			"required": ["name", "timezone", "email", "branding"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"timezone": {
					"type": "string",
					"description": "IANA timezone identifier (e.g. America/New_York).",
					"minLength": 1
				},
				"email": {
					"type": "string",
					"format": "email"
				},
				"branding": {
					"$ref": "#/$defs/Branding",
					"default": {}
				}
			}
		},
		"Branding": {
			"title": "Branding",
			"type": "object",
			"additionalProperties": false,
			"required": ["color"],
			"properties": {
				"logo_url": {
					"type": "string",
					"minLength": 1
				},
				"color": {
					"type": "object",
					"additionalProperties": false,
					"required": ["primary"],
					"default": {},
					"properties": {
						"primary": {
							"type": "object",
							"additionalProperties": false,
							"required": ["light", "dark"],
							"default": {},
							"properties": {
								"light": {
									"$ref": "#/$defs/HexColor",
									"default": "#4f46e5"
								},
								"dark": {
									"$ref": "#/$defs/HexColor",
									"default": "#818cf8"
								}
							}
						}
					}
				},
				"avatar_url": {
					"type": "string",
					"minLength": 1
				},
				"favicon_url": {
					"type": "string",
					"minLength": 1
				},
				"page_title": {
					"type": "string",
					"minLength": 1
				},
				"description": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"HexColor": {
			"type": "string",
			"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
		},
		"Smtp": {
			"title": "Smtp",
			"description": "SMTP server used to send appointment emails. Required — the appointment system relies on it.",
			"type": "object",
			"additionalProperties": false,
			"required": ["host", "port", "user", "pass"],
			"properties": {
				"host": {
					"type": "string",
					"minLength": 1
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"user": {
					"type": "string",
					"minLength": 1
				},
				"pass": {
					"type": "string",
					"minLength": 1
				},
				"from": {
					"type": "string",
					"description": "Email address used as the From on all emails and as the organizer on guest-facing calendar invites, so the host's own address is never exposed. Must be an address your SMTP server is allowed to send from. Defaults to noreply@<your url.app domain>. The display name always comes from user.name.",
					"minLength": 1
				}
			}
		},
		"Calendar": {
			"title": "Calendar",
			"oneOf": [
				{
					"$ref": "#/$defs/GoogleCalendar"
				},
				{
					"$ref": "#/$defs/CalDavCalendar"
				}
			]
		},
		"GoogleCalendar": {
			"title": "GoogleCalendar",
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"type",
				"client_id",
				"client_secret",
				"refresh_token",
				"google_calendar_id"
			],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"const": "google"
				},
				"client_id": {
					"type": "string",
					"minLength": 1
				},
				"client_secret": {
					"type": "string",
					"minLength": 1
				},
				"refresh_token": {
					"type": "string",
					"minLength": 1
				},
				"google_calendar_id": {
					"type": "string",
					"minLength": 1
				},
				"sync": {
					"$ref": "#/$defs/CalendarSync"
				}
			}
		},
		"CalDavCalendar": {
			"title": "CalDavCalendar",
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "url", "username", "password"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"const": "caldav"
				},
				"url": {
					"type": "string",
					"format": "uri"
				},
				"username": {
					"type": "string",
					"minLength": 1
				},
				"password": {
					"type": "string",
					"minLength": 1
				},
				"sync": {
					"$ref": "#/$defs/CalendarSync"
				}
			}
		},
		"CalendarSync": {
			"title": "CalendarSync",
			"description": "Per-calendar sync cadence.",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"refresh_interval": {
					"type": "integer",
					"description": "Minutes between the worker's busy-time refreshes for this calendar.",
					"minimum": 1,
					"default": 10
				}
			}
		},
		"Availability": {
			"title": "Availability",
			"description": "Global availability defaults. Each knob is overridable per event type.",
			"type": "object",
			"additionalProperties": false,
			"required": ["default"],
			"properties": {
				"slot_granularity": {
					"type": "integer",
					"minimum": 1,
					"default": 15
				},
				"minimum_notice": {
					"type": "integer",
					"minimum": 0,
					"default": 120
				},
				"maximum_lookahead": {
					"type": "integer",
					"minimum": 1,
					"default": 60
				},
				"buffer_before": {
					"type": "integer",
					"minimum": 0,
					"default": 0
				},
				"buffer_after": {
					"type": "integer",
					"minimum": 0,
					"default": 0
				},
				"max_appointments_per_day": {
					"type": ["integer", "null"],
					"minimum": 1,
					"default": null
				},
				"default": {
					"$ref": "#/$defs/WeeklySchedule"
				}
			}
		},
		"WeeklySchedule": {
			"title": "WeeklySchedule",
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"monday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"tuesday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"wednesday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"thursday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"friday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"saturday": {
					"$ref": "#/$defs/DaySchedule"
				},
				"sunday": {
					"$ref": "#/$defs/DaySchedule"
				}
			}
		},
		"DaySchedule": {
			"title": "DaySchedule",
			"description": "Array of HH:MM-HH:MM time ranges in the user's timezone.",
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$"
			}
		},
		"EventType": {
			"title": "EventType",
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "name", "duration", "slug", "appointment_flow", "destination_calendar"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"duration": {
					"type": "integer",
					"minimum": 1
				},
				"description": {
					"type": "string"
				},
				"slug": {
					"type": "string",
					"pattern": "^[a-z0-9][a-z0-9-]*$"
				},
				"visibility": {
					"enum": ["public", "private"],
					"default": "public"
				},
				"appointment_flow": {
					"enum": ["auto", "requires_confirmation"]
				},
				"conflict_calendars": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					},
					"default": []
				},
				"destination_calendar": {
					"type": "string",
					"minLength": 1
				},
				"location": {
					"$ref": "#/$defs/Location"
				},
				"note": {
					"type": "string",
					"minLength": 1
				},
				"conference": {
					"type": "string",
					"format": "uri"
				},
				"slot_granularity": {
					"type": "integer",
					"minimum": 1
				},
				"minimum_notice": {
					"type": "integer",
					"minimum": 0
				},
				"maximum_lookahead": {
					"type": "integer",
					"minimum": 1
				},
				"buffer_before": {
					"type": "integer",
					"minimum": 0
				},
				"buffer_after": {
					"type": "integer",
					"minimum": 0
				},
				"max_appointments_per_day": {
					"type": ["integer", "null"],
					"minimum": 1
				},
				"image_url": {
					"type": "string",
					"minLength": 1
				},
				"form_fields": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/FormField"
					}
				}
			}
		},
		"FormField": {
			"title": "FormField",
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "type", "label", "required"],
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"enum": [
						"guest_name",
						"guest_email",
						"event_location",
						"text",
						"number",
						"paragraph",
						"choice"
					]
				},
				"label": {
					"type": "string",
					"minLength": 1
				},
				"required": {
					"type": "boolean",
					"default": false
				},
				"choices": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"Location": {
			"title": "Location",
			"oneOf": [
				{
					"$ref": "#/$defs/LocationFixed"
				}
			]
		},
		"LocationFixed": {
			"title": "LocationFixed",
			"type": "object",
			"additionalProperties": false,
			"required": ["mode", "fixed"],
			"properties": {
				"mode": {
					"const": "fixed"
				},
				"fixed": {
					"type": "string",
					"minLength": 1
				}
			}
		},
		"PrometheusConfig": {
			"title": "PrometheusConfig",
			"description": "Prometheus metrics collection settings.",
			"type": "object",
			"additionalProperties": false,
			"required": ["enabled", "secret"],
			"properties": {
				"enabled": {
					"type": "boolean",
					"description": "Whether metrics collection and endpoint are active.",
					"default": false
				},
				"secret": {
					"type": "string",
					"description": "Bearer token for scraping metrics. Defaults to METRICS_TOKEN env var.",
					"default": "${METRICS_TOKEN:-}"
				}
			}
		}
	}
}
