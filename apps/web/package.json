{
	"name": "@when/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"files": [
		"build"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"validate-config": "node ./cli/validate-config.ts",
		"hash-password": "node ./cli/hash-password.ts",
		"setup-google": "node ./cli/setup-google.ts",
		"dev:docker": "docker compose -f docker-compose.dev.yml up"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@iconify-json/ph": "1.2.2",
		"@playwright/test": "1.60.0",
		"@sveltejs/adapter-node": "5.5.4",
		"@sveltejs/kit": "2.61.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/node": "24.12.4",
		"@types/nodemailer": "8.0.0",
		"@vitest/coverage-v8": "4.1.7",
		"eslint": "10.4.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.18.0",
		"globals": "17.6.0",
		"pino-pretty": "13.1.3",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"svelte": "5.56.0",
		"svelte-check": "4.4.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.60.0",
		"unplugin-icons": "23.0.1",
		"vite": "8.0.14",
		"vitest": "4.1.7"
	},
	"dependencies": {
		"@auth/sveltekit": "1.11.2",
		"@internationalized/date": "3.12.2",
		"@js-temporal/polyfill": "0.5.1",
		"@node-rs/argon2": "2.0.2",
		"@when/config": "workspace:*",
		"@when/db": "workspace:*",
		"@when/jobs": "workspace:*",
		"bits-ui": "2.18.1",
		"kysely": "0.28.17",
		"marked": "18.0.4",
		"nodemailer": "8.0.10",
		"pino": "10.3.1",
		"prom-client": "15.1.3",
		"ts-ics": "2.4.4",
		"yaml": "2.9.0"
	}
}
