# Copy to `.env` alongside this file and fill in. Both compose files load it with
# `env_file:`, so nothing is baked into the image — ship the image, bring your own
# `.env` and `config/when.yaml`.

# --- Read directly by the app ---

# Auth.js JWT signing secret. Required, 32+ characters.
#   openssl rand -base64 32
AUTH_SECRET=

# Public base URL, no trailing slash — e.g. https://when.example.com
# Required behind a reverse proxy: without it every form POST fails SvelteKit's
# CSRF origin check with a 403. Also the default for `url.app` in when.yaml, so
# set it here and leave that unset rather than writing the URL twice.
ORIGIN=

# --- Referenced from when.yaml via ${...} ---
# These names are whatever your config uses. Below are the ones `when-cli config
# init` writes; `<NAME>` is the service name upper-cased.

WHEN_ADMIN_PASSWORD=
WHEN_SMTP_PASS=
# WHEN_OIDC_CLIENT_SECRET=
# WHEN_SERVICE_CALDAV_<NAME>_PASSWORD=
# WHEN_SERVICE_GOOGLE_<NAME>_CLIENT_SECRET=
# WHEN_SERVICE_GOOGLE_<NAME>_REFRESH_TOKEN=
# METRICS_TOKEN=
