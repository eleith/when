FROM node:24-alpine

WORKDIR /app

# pnpm via corepack (Node 24 ships it). COREPACK_HOME is a shared, world-readable
# path so the cached pnpm works at runtime no matter which host UID/GID the
# container runs as (docker-compose.dev.yml uses `user: ${UID}:${GID}`).
ENV COREPACK_HOME=/usr/local/corepack
RUN corepack enable

# Copy the whole workspace first so the @when/* members are present for the
# frozen-lockfile install (pnpm needs every workspace package.json to resolve the
# workspace:* deps). --ignore-scripts: `prepare` (svelte-kit sync) is run by
# `pnpm dev` itself at startup.
COPY . .
RUN pnpm install --frozen-lockfile --ignore-scripts

# Runtime-writable dirs (the host-mapped UID needs write here):
#   /app                  — vite drops a .timestamp-*.mjs next to vite.config.ts
#   /app/node_modules     — vite/svelte-kit create .vite/ and .cache/ subdirs
#   /app/.svelte-kit      — svelte-kit sync output
#   /app/data             — SQLite database
# Mode 777 on the dir alone (no -R); root-owned files inside stay readable by
# everyone (default 644). COREPACK_HOME is made readable so any UID can run pnpm.
RUN mkdir -p /app/data /app/.svelte-kit && \
    chmod 777 /app /app/node_modules /app/data /app/.svelte-kit && \
    chmod -R a+rX "$COREPACK_HOME"

EXPOSE 5173
CMD ["pnpm", "run", "dev", "--host", "0.0.0.0"]
