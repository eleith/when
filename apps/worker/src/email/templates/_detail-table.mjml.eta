<% const shown = it.rows.filter((r) => r.value); %>
<% if (shown.length) { %>
<mj-table font-size="14px" padding="8px 0 24px" cellpadding="0">
  <% shown.forEach((row) => { %>
  <tr>
    <td style="padding:4px 16px 4px 0;color:#6b7280;font-weight:600;white-space:nowrap;vertical-align:top;"><%= row.label %></td>
    <td style="padding:4px 0;vertical-align:top;"><%= row.value %></td>
  </tr>
  <% }) %>
</mj-table>
<% } %>
