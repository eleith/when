<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<title><%= it.heading %></title>
	</head>
	<body style="margin: 0; padding: 0; background: #f3f4f6;">
		<table
			role="presentation"
			width="100%"
			cellpadding="0"
			cellspacing="0"
			border="0"
			style="background: #f3f4f6;"
		>
			<tr>
				<td align="center" style="padding: 24px 12px;">
					<table
						role="presentation"
						width="560"
						cellpadding="0"
						cellspacing="0"
						border="0"
						style="width: 560px; max-width: 100%;"
					>
						<tr>
							<td
								style="height: 6px; font-size: 0; line-height: 0; border-radius: 8px 8px 0 0; background: <%= it.brand.primaryColor %>;"
							>
								&nbsp;
							</td>
						</tr>
						<tr>
							<td
								style="padding: 32px; border-radius: 0 0 8px 8px; background: #ffffff; color: #1a1a1a; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
							>
								<% if (it.brand.logoUrl) { %>
								<img
									src="<%= it.brand.logoUrl %>"
									alt="<%= it.brand.name %>"
									width="140"
									style="display: block; border: 0; margin: 0 0 16px;"
								/>
								<% } else { %>
								<p
									style="margin: 0 0 16px; font-size: 18px; font-weight: 700; color: <%= it.brand.primaryColor %>;"
								>
									<%= it.brand.name %>
								</p>
								<% } %>

								<p style="margin: 0 0 16px; font-size: 18px; font-weight: 700; line-height: 1.3;">
									<%= it.heading %>
								</p>

								<% it.paragraphs.forEach(function (p) { %>
								<p style="margin: 0 0 12px; font-size: 14px; line-height: 1.5; color: #4b5563;">
									<%= p %>
								</p>
								<% }) %>

								<% const rows = it.rows.filter(function (r) { return r.value; }); %> <% if
								(rows.length) { %>
								<table
									role="presentation"
									cellpadding="0"
									cellspacing="0"
									border="0"
									style="width: 100%; margin: 8px 0 16px;"
								>
									<% rows.forEach(function (r) { %>
									<tr>
										<td
											style="padding: 4px 12px 4px 0; font-size: 13px; color: #6b7280; vertical-align: top; white-space: nowrap;"
										>
											<%= r.label %>
										</td>
										<td style="padding: 4px 0; font-size: 13px; color: #1a1a1a;"><%= r.value %></td>
									</tr>
									<% }) %>
								</table>
								<% } %> <% if (it.actions.length) { %> <% const variants = { primary: { bg:
								it.brand.primaryColor, fg: '#ffffff', bd: it.brand.primaryColor }, secondary: { bg:
								'#ffffff', fg: '#1a1a1a', bd: '#d1d5db' }, danger: { bg: '#ffffff', fg: '#b91c1c',
								bd: '#fecaca' } }; %>
								<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 8px 0 4px;">
									<tr>
										<% it.actions.forEach(function (a) { %> <% const v = variants[a.variant]; %>
										<td style="padding: 0 8px 0 0;">
											<table role="presentation" cellpadding="0" cellspacing="0" border="0">
												<tr>
													<td
														style="border-radius: 6px; background: <%= v.bg %>; border: 1px solid <%= v.bd %>;"
													>
														<a
															href="<%= a.href %>"
															style="display: inline-block; padding: 11px 18px; font-size: 14px; font-weight: 600; text-decoration: none; mso-padding-alt: 0; color: <%= v.fg %>;"
															><%= a.label %></a
														>
													</td>
												</tr>
											</table>
										</td>
										<% }) %>
									</tr>
								</table>
								<% } %>

								<p style="margin: 20px 0 0; font-size: 12px; line-height: 1.5; color: #9ca3af;">
									<% if (it.footerHref) { %>
									<a href="<%= it.footerHref %>" style="color: <%= it.brand.primaryColor %>;"
										>View this booking</a
									><br />
									<% } %> <%= it.brand.name %> &middot; Powered by When
								</p>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
