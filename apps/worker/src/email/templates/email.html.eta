<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<title><%= it.heading %></title>
	</head>
	<body style="margin: 0; padding: 0; background: #f3f4f6;">
		<table
			role="presentation"
			width="100%"
			cellpadding="0"
			cellspacing="0"
			border="0"
			style="background: #f3f4f6;"
		>
			<tr>
				<td align="center" style="padding: 32px 16px;">
					<table
						role="presentation"
						width="600"
						cellpadding="0"
						cellspacing="0"
						border="0"
						style="width: 600px; max-width: 100%; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
					>
						<tr>
							<td style="padding: 0 8px 18px;">
								<table role="presentation" cellpadding="0" cellspacing="0" border="0">
									<tr>
										<% if (it.brand.logoUrl) { %>
										<td style="padding: 0 12px 0 0; vertical-align: middle;">
											<img
												src="<%= it.brand.logoUrl %>"
												alt="<%= it.brand.name %>"
												height="36"
												style="display: block; border: 0; height: 36px; width: auto;"
											/>
										</td>
										<% } %>
										<td
											style="vertical-align: middle; font-size: 17px; font-weight: 700; color: #1a1a1a;"
										>
											<%= it.brand.pageTitle %>
										</td>
									</tr>
								</table>
							</td>
						</tr>
						<tr>
							<td
								style="padding: 28px 40px; border-radius: 10px 10px 0 0; background: <%= it.brand.primaryColor %>; color: <%= it.brand.onPrimary %>;"
							>
								<h1
									style="margin: 0; font-size: 23px; font-weight: 700; line-height: 1.3; color: <%= it.brand.onPrimary %>;"
								>
									<%= it.heading %>
								</h1>
							</td>
						</tr>
						<tr>
							<td
								style="padding: 36px 40px; background: #ffffff; color: #1a1a1a; border-radius: 0 0 10px 10px;"
							>
								<% it.paragraphs.forEach(function (p) { %>
								<p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: #4b5563;">
									<%= p %>
								</p>
								<% }) %> <% const rows = it.rows.filter(function (r) { return r.value; }); %> <% if
								(rows.length) { %>
								<table
									role="presentation"
									width="100%"
									cellpadding="0"
									cellspacing="0"
									border="0"
									style="width: 100%; margin: <%= it.paragraphs.length ? '8px' : '0' %> 0 0;"
								>
									<tr>
										<td style="border-left: 3px solid #d1d5db; padding: 4px 0 4px 18px;">
											<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width: 100%;">
												<% rows.forEach(function (r) { %>
												<tr>
													<td
														style="padding: 9px 16px 9px 0; font-size: 15px; color: #6b7280; vertical-align: top; white-space: nowrap;"
													>
														<%= r.label %>
													</td>
													<td style="padding: 9px 0; font-size: 16px; font-weight: 600; color: #1a1a1a;">
														<%= r.value %>
													</td>
												</tr>
												<% }) %>
											</table>
										</td>
									</tr>
								</table>
								<% } %> <% if (it.actions.length) { %> <% const variants = { primary: { bg:
								it.brand.primaryColor, fg: it.brand.onPrimary, bd: it.brand.primaryColor }, secondary: {
								bg: '#ffffff', fg: '#1a1a1a', bd: '#d1d5db' }, danger: { bg: '#ffffff', fg: '#b91c1c', bd:
								'#fecaca' } }; %>
								<table
									role="presentation"
									align="center"
									cellpadding="0"
									cellspacing="0"
									border="0"
									style="margin: 28px auto 4px;"
								>
									<tr>
										<% it.actions.forEach(function (a) { %> <% const v = variants[a.variant]; %>
										<td style="padding: 0 5px;">
											<table role="presentation" cellpadding="0" cellspacing="0" border="0">
												<tr>
													<td
														style="border-radius: 6px; background: <%= v.bg %>; border: 1px solid <%= v.bd %>;"
													>
														<a
															href="<%= a.href %>"
															style="display: inline-block; padding: 14px 24px; font-size: 16px; font-weight: 600; text-decoration: none; mso-padding-alt: 0; color: <%= v.fg %>;"
															><%= a.label %></a
														>
													</td>
												</tr>
											</table>
										</td>
										<% }) %>
									</tr>
								</table>
								<% } %>
							</td>
						</tr>
					</table>
				</td>
			</tr>
		</table>
	</body>
</html>
