<!doctype html>
<html
	lang="en"
	dir="auto"
	xmlns="http://www.w3.org/1999/xhtml"
	xmlns:v="urn:schemas-microsoft-com:vml"
	xmlns:o="urn:schemas-microsoft-com:office:office"
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
		<!--[if !mso]><!-->
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<!--<![endif]-->
		<title><%= it.heading %></title>
		<style>
			#outlook a {
				padding: 0;
			}
			body {
				margin: 0;
				padding: 0;
				-webkit-text-size-adjust: 100%;
				-ms-text-size-adjust: 100%;
			}
			table,
			td {
				border-collapse: collapse;
				mso-table-lspace: 0pt;
				mso-table-rspace: 0pt;
			}
			img {
				border: 0;
				height: auto;
				line-height: 100%;
				outline: none;
				text-decoration: none;
				-ms-interpolation-mode: bicubic;
			}
			@media only screen and (max-width: 480px) {
				.sm-px {
					padding-left: 24px !important;
					padding-right: 24px !important;
				}
				.sm-btn {
					display: block !important;
					width: 100% !important;
					padding: 6px 0 !important;
				}
				.sm-btn table {
					width: 100% !important;
				}
				.sm-btn a {
					display: block !important;
				}
			}
		</style>
		<!--[if mso]>
			<noscript>
				<xml>
					<o:OfficeDocumentSettings>
						<o:AllowPNG />
						<o:PixelsPerInch>96</o:PixelsPerInch>
					</o:OfficeDocumentSettings>
				</xml>
			</noscript>
		<![endif]-->
	</head>
	<body style="margin: 0; padding: 0; word-spacing: normal; background: <%= it.theme.pageBg %>;">
		<div role="article" aria-roledescription="email" lang="en" dir="auto" style="background: <%= it.theme.pageBg %>;">
			<% if (it.previewText) { %>
			<div style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
				<%= it.previewText %>
			</div>
			<div style="display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
				&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;&#847;&zwnj;&nbsp;&#8199;&#65279;
			</div>
			<% } %>
			<table
				role="presentation"
				width="100%"
				cellpadding="0"
				cellspacing="0"
				border="0"
				style="width: 100%; background: <%= it.theme.pageBg %>;"
			>
				<tr>
					<td align="center" style="padding: 32px 16px;">
						<!--[if mso | IE]><table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" width="600" style="width:600px;"><tr><td><![endif]-->
						<div style="margin: 0 auto; max-width: 600px;">
							<table
								role="presentation"
								align="center"
								width="100%"
								cellpadding="0"
								cellspacing="0"
								border="0"
								style="width: 100%; max-width: 600px; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;"
							>
								<tr>
									<td
										class="sm-px"
										style="padding: 38px 40px 36px; background: <%= it.theme.surface %>; color: <%= it.theme.text %>; border-radius: <%= it.theme.cardRadius %>;"
									>
										<h1
											style="margin: 0 0 20px; font-size: 24px; font-weight: 700; line-height: 1.3; color: <%= it.theme.text %>;"
										>
											<%= it.heading %>
										</h1>
										<% it.paragraphs.forEach(function (p) { %>
										<p style="margin: 0 0 16px; font-size: 16px; line-height: 1.6; color: <%= it.theme.bodyText %>; word-break: break-word;">
											<%= p %>
										</p>
										<% }) %> <% const rows = it.rows.filter(function (r) { return r.value; }); %> <% if
										(rows.length) { %>
										<table
											role="presentation"
											width="100%"
											cellpadding="0"
											cellspacing="0"
											border="0"
											style="width: 100%; margin: <%= it.paragraphs.length ? '8px' : '0' %> 0 0;"
										>
											<tr>
												<td style="border-left: 3px solid <%= it.theme.border %>; padding: 4px 0 4px 18px;">
													<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width: 100%;">
														<% rows.forEach(function (r) { %>
														<tr>
															<td
																width="35%"
																style="width: 35%; padding: 9px 16px 9px 0; font-size: 15px; color: <%= it.theme.label %>; vertical-align: top; word-break: break-word;"
															>
																<%= r.label %>
															</td>
															<td style="padding: 9px 0; font-size: 16px; color: <%= it.theme.text %>; word-break: break-word;">
																<%= r.value %>
															</td>
														</tr>
														<% }) %>
													</table>
												</td>
											</tr>
										</table>
										<% } %> <% if (it.actions.length) { %> <% /* secondary + danger retained for future
										actions; only primary is emitted today */ const variants = { primary: { bg:
										it.brand.primaryColor, fg: it.brand.onPrimary, bd: it.brand.primaryColor }, secondary: {
										bg: it.theme.surface, fg: it.theme.text, bd: it.theme.border }, danger: { bg:
										it.theme.surface, fg: it.theme.dangerText, bd: it.theme.dangerBorder } }; %>
										<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 28px 0 4px;">
											<tr>
												<% it.actions.forEach(function (a) { %> <% const v = variants[a.variant]; %>
												<td class="sm-btn" align="center" style="padding: 0 10px 0 0;">
													<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="border-collapse: separate;">
														<tr>
															<td
																align="center"
																style="border-radius: 6px; background: <%= v.bg %>; border: 1px solid <%= v.bd %>;"
															>
																<a
																	href="<%= a.href %>"
																	style="display: inline-block; padding: 14px 26px; font-size: 16px; font-weight: 600; text-decoration: none; mso-padding-alt: 0; color: <%= v.fg %>;"
																	><%= a.label %></a
																>
															</td>
														</tr>
													</table>
												</td>
												<% }) %>
											</tr>
										</table>
										<% } %>
									</td>
								</tr>
								<tr>
									<td style="padding: 20px 8px 0;">
										<table role="presentation" cellpadding="0" cellspacing="0" border="0">
											<tr>
												<% if (it.brand.logoUrl) { %>
												<td style="padding: 0 6px 0 0; vertical-align: middle;">
													<img
														src="<%= it.brand.logoUrl %>"
														alt="<%= it.brand.name %>"
														height="22"
														style="display: block; border: 0; height: 22px; width: auto;"
													/>
												</td>
												<td style="padding: 0 6px 0 0; vertical-align: middle; font-size: 13px; color: <%= it.theme.border %>;">
													&middot;
												</td>
												<% } %>
												<td style="vertical-align: middle; font-size: 13px; line-height: 1.5;">
													<a href="<%= it.brand.appUrl %>" style="color: <%= it.theme.label %>; text-decoration: none;"
														><%= it.brand.appUrl %></a
													>
												</td>
											</tr>
										</table>
									</td>
								</tr>
							</table>
						</div>
						<!--[if mso | IE]></td></tr></table><![endif]-->
					</td>
				</tr>
			</table>
		</div>
	</body>
</html>
