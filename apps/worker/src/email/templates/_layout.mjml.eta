<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text font-size="15px" color="#1a1a1a" line-height="1.6" padding="0 0 16px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f6f7f9" width="560px">
    <!-- brand strip -->
    <mj-section background-color="<%= it.brand.primaryColor %>" padding="0">
      <mj-column>
        <mj-text font-size="1px" line-height="6px" padding="0">&nbsp;</mj-text>
      </mj-column>
    </mj-section>
    <!-- card -->
    <mj-section background-color="#ffffff" padding="24px" border="1px solid #e5e7eb">
      <mj-column>
        <% if (it.brand.logoUrl) { %>
        <mj-image src="<%= it.brand.logoUrl %>" alt="<%= it.brand.name %>" align="left" width="140px" padding="0 0 16px" />
        <% } else { %>
        <mj-text font-size="18px" font-weight="700" color="<%= it.brand.primaryColor %>" padding="0 0 16px"><%= it.brand.name %></mj-text>
        <% } %>
        <%~ it.body %>
      </mj-column>
    </mj-section>
    <!-- footer -->
    <mj-section padding="16px 0">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0"><% if (it.footerHref) { %><a href="<%= it.footerHref %>" style="color:<%= it.brand.primaryColor %>;">View this booking</a><br /><% } %><%= it.brand.name %> &middot; Powered by When</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
