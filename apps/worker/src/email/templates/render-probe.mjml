<% layout("./_layout.mjml", { orgName: it.orgName, footerHref: it.footerHref }) %>
<mj-section>
  <mj-column>
    <mj-text font-size="20px" font-weight="bold"><%= it.heading %></mj-text>
    <mj-table>
      <% it.rows.forEach((row) => { %>
        <tr>
          <td style="padding: 4px 8px; color: #888888;"><%= row.label %></td>
          <td style="padding: 4px 8px;"><%= row.value %></td>
        </tr>
      <% }) %>
    </mj-table>
    <% if (it.note) { %>
      <mj-text color="#555555"><%= it.note %></mj-text>
    <% } %>
    <mj-button href="<%= it.actionHref %>" background-color="#2563eb"><%= it.actionLabel %></mj-button>
  </mj-column>
</mj-section>
