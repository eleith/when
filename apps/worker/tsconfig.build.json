{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": false,
		"incremental": true,
		"tsBuildInfoFile": "node_modules/.cache/tsc/worker.tsbuildinfo",
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "build", "**/*.test.ts", "**/__fixtures__/**"]
}
