{
	"name": "@when/worker",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"files": [
		"dist/*",
		"package.json"
	],
	"scripts": {
		"dev": "pnpm build && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/src/index.js)",
		"build": "tsc -p tsconfig.build.json && pnpm build:assets",
		"build:assets": "mkdir -p dist/src/email/templates && cp -r src/email/templates/. dist/src/email/templates/",
		"start": "node dist/src/index.js",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@when/calendar": "workspace:*",
		"@when/config": "workspace:*",
		"@when/db": "workspace:*",
		"@when/jobs": "workspace:*",
		"@when/video-chat": "workspace:*",
		"eta": "4.6.0",
		"kysely": "0.28.17",
		"nodemailer": "8.0.10",
		"openworkflow": "0.9.0",
		"pino": "10.3.1",
		"prom-client": "15.1.3",
		"ts-ics": "2.4.4"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@types/node": "catalog:",
		"@types/nodemailer": "8.0.0",
		"@vitest/coverage-v8": "catalog:",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"globals": "catalog:",
		"pino-pretty": "13.1.3",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
