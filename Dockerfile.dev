FROM --platform=linux/amd64 oven/bun:1.3.13-alpine

WORKDIR /app

# Install deps first for layer caching.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Copy the rest of the project so the image is self-contained.
COPY . .

# Runtime-writable dirs (host-mapped UID writes here): SQLite db lives
# in /app/data; svelte-kit sync writes to /app/.svelte-kit on dev start.
RUN mkdir -p /app/data /app/.svelte-kit && \
    chmod 777 /app/data /app/.svelte-kit

EXPOSE 5173
CMD ["bun", "run", "dev", "--host", "0.0.0.0"]
