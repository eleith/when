# Optional: copy to .env beside compose.yaml only if you want environment overrides
# or ${VAR} references in when.yaml. The normal setup edits when.yaml directly.
# Keep this file private and out of Git. Uncomment only the values you use.

# Published host port only; container ports and internal service URLs stay unchanged.
# WHEN_HTTP_PORT=8080

# Example: use password: '${WHEN_ADMIN_PASSWORD}' in when.yaml.
# WHEN_ADMIN_PASSWORD=your-own-password
# WHEN_SMTP_PASSWORD=your-smtp-password
# WHEN_OIDC_CLIENT_SECRET=your-provider-client-secret
# WHEN_PROVIDER_CALDAV_SERVICE_PASSWORD=your-caldav-password
# WHEN_METRICS_TOKEN=your-scrape-token

# Optional stable session key; YAML auth.secret takes precedence.
# Generate once with: openssl rand -base64 32
# AUTH_SECRET=your-generated-secret-of-at-least-32-characters

# Optional defaults when omitted from YAML; explicit YAML values take precedence.
# ORIGIN=https://when.example.com
# TZ=UTC

# Set native PORT overrides per service in Compose, not in this shared file:
# web defaults to 3000, worker to 9000. Coordinate healthchecks and internal URLs
# if you change container ports. The web proxy settings live in compose.yaml.
