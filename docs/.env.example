# Copy to .env beside compose.yaml. Keep it private and out of Git.
# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
ORIGIN=http://localhost:3000

# Match the ${...} references in config/when.yaml.
WHEN_ADMIN_PASSWORD=
WHEN_SMTP_PASSWORD=
WHEN_PROVIDER_CALDAV_SERVICE_PASSWORD=

# Optional services. Replace <NAME> with the provider key, uppercase, hyphens as _.
# WHEN_OIDC_CLIENT_SECRET=
# WHEN_PROVIDER_<NAME>_PASSWORD=
# WHEN_PROVIDER_<NAME>_CLIENT_SECRET=
# WHEN_PROVIDER_<NAME>_REFRESH_TOKEN=
# WHEN_METRICS_TOKEN=
