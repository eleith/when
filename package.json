{
	"name": "when-monorepo",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"build:packages": "pnpm --filter \"./packages/*\" -r build",
		"build": "pnpm --filter @when/web build",
		"check": "pnpm --filter @when/web check",
		"lint": "pnpm --filter @when/web lint",
		"format": "pnpm --filter @when/web format",
		"test": "pnpm -r test",
		"test:coverage": "pnpm -r test:coverage",
		"test:e2e": "pnpm --filter @when/web test:e2e",
		"cli": "pnpm --filter @when/cli start",
		"changeset": "changeset",
		"version:apps": "changeset version",
		"tag:apps": "changeset git-tag"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.1",
		"@when/cli": "workspace:*",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"typescript": "6.0.3"
	}
}
