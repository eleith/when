{
	"name": "when-monorepo",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"build:packages": "pnpm --filter \"./packages/*\" -r build",
		"dev": "pnpm --filter @when/web dev",
		"dev:docker": "pnpm --filter @when/web dev:docker",
		"build": "pnpm --filter @when/web build",
		"preview": "pnpm --filter @when/web preview",
		"check": "pnpm --filter @when/web check",
		"lint": "pnpm --filter @when/web lint",
		"format": "pnpm --filter @when/web format",
		"test": "pnpm --filter @when/web test",
		"test:e2e": "pnpm --filter @when/web test:e2e",
		"cli": "pnpm --filter @when/cli start"
	},
	"devDependencies": {
		"@when/cli": "workspace:*",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "3.5.2",
		"typescript": "6.0.3"
	}
}
